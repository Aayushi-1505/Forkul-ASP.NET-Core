{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Forkful.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "run HTTP (5000)",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/Forkful.csproj", "--launch-profile", "http"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run HTTPS (5001 + 5000)",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/Forkful.csproj", "--launch-profile", "https"],
      "problemMatcher": "$msCompile"
    }
  ]
}
