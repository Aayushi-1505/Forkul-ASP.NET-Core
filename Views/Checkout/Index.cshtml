@model CheckoutViewModel
<section class="shell inner-page checkout-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-controller="Menu" asp-action="Index">Menu</a><span>/</span><a asp-controller="Cart" asp-action="Index">Cart</a><span>/</span><span>Checkout</span></nav>
    <div class="inner-page-heading"><span class="eyebrow">JUST ONE MORE STEP</span><h1>Let's make it <em>yours.</em></h1><p>A few details, and we'll take care of the delicious part.</p></div>
    <form asp-controller="Checkout" asp-action="Index" method="post" class="checkout-layout" novalidate>
        <div class="checkout-fields">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <section class="checkout-panel"><div class="panel-head"><span class="panel-step">01</span><div><h2>How would you like it?</h2><p>Choose the option that works for you.</p></div></div><div class="choice-row"><label class="choice-card"><input asp-for="DeliveryType" type="radio" value="Delivery" checked="@(Model.DeliveryType == "Delivery")" /><span class="choice-icon" aria-hidden="true">⌂</span><span><strong>Delivery</strong><small>Right to your doorstep</small></span><span class="choice-radio"></span></label><label class="choice-card"><input asp-for="DeliveryType" type="radio" value="Pickup" checked="@(Model.DeliveryType == "Pickup")" /><span class="choice-icon" aria-hidden="true">✳</span><span><strong>Pickup</strong><small>Come say hello</small></span><span class="choice-radio"></span></label></div><span asp-validation-for="DeliveryType" class="field-error"></span></section>
            <section class="checkout-panel"><div class="panel-head"><span class="panel-step">02</span><div><h2>Your details</h2><p>So we know who to make this for.</p></div></div><div class="form-grid"><div class="form-field"><label asp-for="CustomerName"></label><input asp-for="CustomerName" placeholder="e.g. Aditi Patel" autocomplete="name" /><span asp-validation-for="CustomerName" class="field-error"></span></div><div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" placeholder="10-digit mobile number" inputmode="tel" autocomplete="tel" /><span asp-validation-for="Phone" class="field-error"></span></div><div class="form-field full-width"><label asp-for="Email"></label><input asp-for="Email" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="form-field full-width" id="address-field"><label asp-for="Address">Delivery address <span class="required-star">*</span></label><textarea asp-for="Address" rows="3" placeholder="House / flat no., street, area and landmark in Surat" autocomplete="street-address"></textarea><span asp-validation-for="Address" class="field-error"></span></div><div class="form-field full-width"><label asp-for="Notes">Order notes <span class="optional">(optional)</span></label><textarea asp-for="Notes" rows="2" placeholder="Anything you'd like us to know about the whole order?"></textarea><span asp-validation-for="Notes" class="field-error"></span></div></div></section>
            <section class="checkout-panel"><div class="panel-head"><span class="panel-step">03</span><div><h2>Payment</h2><p>Simple and easy — no online payment required.</p></div></div><div class="payment-option"><span aria-hidden="true">₹</span><div><strong id="payment-label">Cash on delivery</strong><small>Pay when your food arrives.</small></div><span class="payment-check" aria-hidden="true">✓</span></div><input asp-for="PaymentMethod" type="hidden" /><span asp-validation-for="PaymentMethod" class="field-error"></span></section>
        </div>
        <aside class="order-summary checkout-summary"><h2>Your order <span>@Model.Cart.Count items</span></h2><div class="checkout-items">
            @foreach (var item in Model.Cart.Items)
            {
                <div class="checkout-item"><img src="@item.Product.ImageUrl" alt="" /><div><strong>@item.Product.Name</strong><small>Qty @item.Quantity</small>
                    @if (item.SpiceLevel != "None" || item.AddOns.Count > 0)
                    {
                        <small class="checkout-custom">@string.Join(" · ", (item.SpiceLevel != "None" ? new[] { item.SpiceLevel + " spice" } : Array.Empty<string>()).Concat(item.AddOns.Select(a => a.Name)))</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions)) { <small class="checkout-custom">“@item.SpecialInstructions”</small> }
                </div><span>₹@item.LineTotal.ToString("0")</span></div>
            }
        </div><div class="summary-row"><span>Subtotal</span><strong>₹@Model.Cart.Subtotal.ToString("0")</strong></div><div class="summary-row"><span>Delivery</span><strong data-delivery-fee="@Model.Cart.DeliveryFee.ToString("0")" id="checkout-delivery-fee">@(Model.Cart.DeliveryFee == 0 ? "FREE" : "₹" + Model.Cart.DeliveryFee.ToString("0"))</strong></div><div class="summary-total"><span>Total</span><strong id="checkout-total" data-subtotal="@Model.Cart.Subtotal.ToString("0")">₹@Model.Cart.Total.ToString("0")</strong></div><button type="submit" class="btn btn-dark summary-checkout">Place your order <span class="btn-arrow" aria-hidden="true">↗</span></button><p class="summary-note">By placing your order, you agree this is a classroom demo. No real payment is processed.</p></aside>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
