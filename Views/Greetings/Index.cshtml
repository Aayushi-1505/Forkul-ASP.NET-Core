@model GreetingViewModel
<section class="shell greeting-page"><div class="greeting-copy"><span class="eyebrow">A LITTLE HELLO FROM FORKFUL</span><h1>@Model.Title<br /><em>Hungry yet?</em></h1><p>@Model.Subtitle Our greeting changes with the current time in Surat (Asia/Kolkata), and so does the image beside it.</p><a asp-controller="Menu" asp-action="Index" class="btn btn-dark">Find something good <span class="btn-arrow" aria-hidden="true">↗</span></a><a asp-controller="Home" asp-action="Index" class="greeting-back">← Back to home</a></div><div class="greeting-image"><img src="@Model.Image" alt="Food for the @Model.DayPart" /><span>IT'S A GOOD @Model.DayPart.ToUpperInvariant() ✳</span></div></section>
