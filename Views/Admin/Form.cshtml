@model ProductFormViewModel
@{ bool editing = Model.Id > 0; }
<section class="shell inner-page admin-form-page"><nav class="breadcrumbs"><a asp-controller="Admin" asp-action="Index">Product manager</a><span>/</span><span>@(editing ? "Edit dish" : "Add dish")</span></nav><div class="inner-page-heading"><span class="eyebrow">MVC FORMS + VALIDATION</span><h1>@(editing ? "Edit this" : "Add a new") <em>dish.</em></h1><p>Changes here appear on the menu and through the API.</p></div><form asp-controller="Admin" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="admin-form"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-field full-width"><label asp-for="Name">Dish name</label><input asp-for="Name" placeholder="e.g. Spicy Paneer Wrap" /><span asp-validation-for="Name" class="field-error"></span></div><div class="form-field full-width"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="3" placeholder="What makes this dish delicious?"></textarea><span asp-validation-for="Description" class="field-error"></span></div><div class="form-field"><label asp-for="Price">Price (₹)</label><input asp-for="Price" type="number" min="1" max="10000" step="0.01" /><span asp-validation-for="Price" class="field-error"></span></div><div class="form-field"><label asp-for="PrepMinutes">Prep time (minutes)</label><input asp-for="PrepMinutes" type="number" min="1" max="120" /><span asp-validation-for="PrepMinutes" class="field-error"></span></div><div class="form-field"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="0">Select a category</option></select><span asp-validation-for="CategoryId" class="field-error"></span><small class="field-hint">Use Non-Veg for meat or egg dishes; keep other categories vegetarian.</small></div><div class="form-field"><label asp-for="SupplierId">Supplier</label><select asp-for="SupplierId" asp-items="ViewBag.Suppliers"><option value="0">Select a supplier</option></select><span asp-validation-for="SupplierId" class="field-error"></span></div><div class="form-field full-width"><label asp-for="ImageUrl">Image path</label><input asp-for="ImageUrl" placeholder="/images/menu/pasta.jpg" /><span asp-validation-for="ImageUrl" class="field-error"></span><small class="field-hint">Use a local image in wwwroot/images, e.g. /images/menu/pizza.jpg.</small></div><div class="form-field"><label asp-for="Rating">Rating (out of 5)</label><input asp-for="Rating" type="number" step="0.1" min="0" max="5" /><span asp-validation-for="Rating" class="field-error"></span></div><div class="form-field checkbox-group"><label class="check-row"><input asp-for="IsVegetarian" /> Vegetarian</label><label class="check-row"><input asp-for="IsFeatured" /> Feature on homepage</label><label class="check-row"><input asp-for="IsAvailable" /> Available to order</label></div></div><div class="form-actions"><a asp-controller="Admin" asp-action="Index" class="text-link">Cancel</a><button class="btn btn-dark" type="submit">@(editing ? "Save changes" : "Add to menu") <span class="btn-arrow" aria-hidden="true">↗</span></button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
