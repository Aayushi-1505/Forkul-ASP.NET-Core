@model IReadOnlyList<Product>
<section class="shell inner-page admin-page"><nav class="breadcrumbs"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><span>Product manager</span></nav><div class="admin-top"><div><span class="eyebrow">CLASSROOM CRUD DEMO</span><h1>Product <em>manager.</em></h1><p>Create, read, update and delete dishes with MVC forms and EF Core.</p></div><a asp-controller="Admin" asp-action="Create" class="btn btn-dark">+ Add a dish <span class="btn-arrow" aria-hidden="true">↗</span></a></div><div class="demo-warning"><span aria-hidden="true">ⓘ</span> Demo area: product changes are public here for learning. Add authentication before using this in production.</div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Dish</th><th>Category</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var product in Model) { <tr><td><div class="admin-product"><img src="@product.ImageUrl" alt="" /><div><strong>@product.Name</strong><small>#@product.Id · @product.Slug</small></div></div></td><td>@product.Category.Name</td><td>₹@product.Price.ToString("0")</td><td><span class="status-pill @(product.IsAvailable ? "available" : "unavailable")">@(product.IsAvailable ? "Available" : "Hidden")</span></td><td class="action-links"><a asp-controller="Admin" asp-action="Edit" asp-route-id="@product.Id">Edit</a><a asp-controller="Admin" asp-action="Delete" asp-route-id="@product.Id" class="danger-link">Delete</a></td></tr> }</tbody></table></div><div class="admin-bottom"><span>@Model.Count dishes in the catalog</span><a href="/api/products" target="_blank" rel="noopener">See the JSON API ↗</a></div></section>
